<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
         http://www.springframework.org/schema/tx
         http://www.springframework.org/schema/tx/spring-tx-4.3.xsd
         http://www.springframework.org/schema/context
         http://www.springframework.org/schema/context/spring-context-4.3.xsd">

  <!--
    Root application context. Hand-written XML, one file, 2014 style.
    Note that the DAO layer is wired here by setter injection while the same
    DAOs ALSO carry @Autowired on their SessionFactory field. Both work; the
    inconsistency is the smell.
  -->

  <context:annotation-config/>

  <!--
    Credentials inline. ConnectionHelper reads a second copy from
    jdbc.properties. Changing the password means editing two files on three
    servers. See docs/LEGACY-SMELLS.md #6.
  -->
  <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
    <property name="driverClassName" value="com.mysql.jdbc.Driver"/>
    <property name="url" value="jdbc:mysql://mysql:3306/campusconnect?useUnicode=true&amp;characterEncoding=UTF-8"/>
    <property name="username" value="campusconnect"/>
    <property name="password" value="campusconnect"/>
  </bean>

  <bean id="sessionFactory" class="org.springframework.orm.hibernate4.LocalSessionFactoryBean">
    <property name="dataSource" ref="dataSource"/>
    <!-- TODO CC-1470: the finance entities were appended to this list in 2016.
         There is no second SessionFactory and no second DataSource: advising
         and billing share one Hibernate session and one transaction manager,
         which is what makes the cross-domain @Transactional methods work. -->
    <property name="packagesToScan" value="com.campusconnect.domain,com.campusconnect.finance.domain"/>
    <property name="hibernateProperties">
      <props>
        <prop key="hibernate.dialect">org.hibernate.dialect.MySQL5InnoDBDialect</prop>
        <prop key="hibernate.show_sql">false</prop>
        <prop key="hibernate.format_sql">false</prop>
        <prop key="hibernate.hbm2ddl.auto">none</prop>
        <!-- XXX CC-1190: left on because two JSPs render lazily-loaded
             collections outside the session. The right fix is to stop doing that. -->
        <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
      </props>
    </property>
  </bean>

  <bean id="transactionManager" class="org.springframework.orm.hibernate4.HibernateTransactionManager">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>

  <tx:annotation-driven transaction-manager="transactionManager"/>

  <!-- DAOs -->
  <bean id="studentDao" class="com.campusconnect.persistence.HibernateStudentDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="advisorDao" class="com.campusconnect.persistence.HibernateAdvisorDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="appointmentDao" class="com.campusconnect.persistence.HibernateAppointmentDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="earlyAlertCaseDao" class="com.campusconnect.persistence.HibernateEarlyAlertCaseDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="courseDao" class="com.campusconnect.persistence.HibernateCourseDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>

  <!-- Finance DAOs. Same sessionFactory, same file, no separate context. -->
  <bean id="studentAccountDao" class="com.campusconnect.finance.persistence.HibernateStudentAccountDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="accountChargeDao" class="com.campusconnect.finance.persistence.HibernateAccountChargeDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="accountPaymentDao" class="com.campusconnect.finance.persistence.HibernateAccountPaymentDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>
  <bean id="financialHoldDao" class="com.campusconnect.finance.persistence.HibernateFinancialHoldDao">
    <property name="sessionFactory" ref="sessionFactory"/>
  </bean>

  <!-- Raw JDBC DAOs. They take no DataSource because they open their own connection. -->
  <bean id="enrollmentDao" class="com.campusconnect.persistence.jdbc.JdbcEnrollmentDao"/>
  <bean id="billingExposureDao" class="com.campusconnect.finance.persistence.jdbc.JdbcBillingExposureDao"/>

  <!-- Services -->
  <bean id="notificationService" class="com.campusconnect.service.NotificationService">
    <property name="fromAddress" value="noreply@campusconnect.example.edu"/>
  </bean>

  <!--
    The advising god class also holds the four finance DAOs, because it computes
    and formats the account balance itself for the student detail screen.
  -->
  <bean id="studentService" class="com.campusconnect.service.StudentService">
    <property name="studentDao" ref="studentDao"/>
    <property name="advisorDao" ref="advisorDao"/>
    <property name="earlyAlertCaseDao" ref="earlyAlertCaseDao"/>
    <property name="enrollmentDao" ref="enrollmentDao"/>
    <property name="studentAccountDao" ref="studentAccountDao"/>
    <property name="accountChargeDao" ref="accountChargeDao"/>
    <property name="accountPaymentDao" ref="accountPaymentDao"/>
    <property name="financialHoldDao" ref="financialHoldDao"/>
  </bean>

  <!--
    CROSS-DOMAIN WIRING. This is the whole seam, and it is four lines of XML:
    the advising scheduler takes the finance hold service, and the advising
    early-alert service takes the finance account service. Nothing else in the
    build records that advising depends on billing.
  -->
  <bean id="appointmentService" class="com.campusconnect.service.AppointmentService">
    <property name="appointmentDao" ref="appointmentDao"/>
    <property name="studentDao" ref="studentDao"/>
    <property name="advisorDao" ref="advisorDao"/>
    <property name="financialHoldService" ref="financialHoldService"/>
  </bean>

  <bean id="earlyAlertService" class="com.campusconnect.service.EarlyAlertService">
    <property name="earlyAlertCaseDao" ref="earlyAlertCaseDao"/>
    <property name="studentDao" ref="studentDao"/>
    <property name="studentAccountService" ref="studentAccountService"/>
  </bean>

  <!-- Student Finance services. Same file, same transaction manager. -->
  <bean id="studentAccountService" class="com.campusconnect.finance.service.StudentAccountService">
    <property name="studentAccountDao" ref="studentAccountDao"/>
    <property name="accountChargeDao" ref="accountChargeDao"/>
    <property name="accountPaymentDao" ref="accountPaymentDao"/>
    <property name="billingExposureDao" ref="billingExposureDao"/>
    <property name="studentDao" ref="studentDao"/>
  </bean>

  <bean id="financialHoldService" class="com.campusconnect.finance.service.FinancialHoldService">
    <property name="financialHoldDao" ref="financialHoldDao"/>
    <property name="studentAccountDao" ref="studentAccountDao"/>
    <property name="studentDao" ref="studentDao"/>
  </bean>

  <!-- SIS batch -->
  <bean id="northlakeImporter" class="com.campusconnect.service.sis.NorthlakeStudentImporter">
    <property name="studentDao" ref="studentDao"/>
    <property name="advisorDao" ref="advisorDao"/>
  </bean>
  <bean id="rivertonImporter" class="com.campusconnect.service.sis.RivertonStudentImporter">
    <property name="studentDao" ref="studentDao"/>
    <property name="advisorDao" ref="advisorDao"/>
  </bean>
  <!-- The nightly job spans both domains: importers, then the finance reconcile. -->
  <bean id="sisImportJob" class="com.campusconnect.service.sis.SisImportJob">
    <property name="northlakeImporter" ref="northlakeImporter"/>
    <property name="rivertonImporter" ref="rivertonImporter"/>
    <property name="studentService" ref="studentService"/>
    <property name="studentAccountService" ref="studentAccountService"/>
    <property name="financialHoldService" ref="financialHoldService"/>
  </bean>

  <!--
    LEGACY SMELL #5: the container is used to populate a static registry, so
    half the application resolves collaborators through global state.
    TODO CC-0977: remove once StudentService and EarlyAlertService take the
    NotificationService by injection like every other bean here.
  -->
  <bean id="serviceLocatorBootstrap"
        class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
    <property name="staticMethod" value="com.campusconnect.common.ServiceLocator.register"/>
    <property name="arguments">
      <list>
        <value>notificationService</value>
        <ref bean="notificationService"/>
      </list>
    </property>
  </bean>

</beans>
